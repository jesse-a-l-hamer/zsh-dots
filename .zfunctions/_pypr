#compdef pypr
# Zsh completion for pypr
# Generated by: pypr compgen zsh

_pypr() {
    local -a commands=(
        'attach:Attach the focused window to the last focused scratchpad.'
        'bar:Start (default), restart, stop or toggle the menu bar.'
        'compgen:Generate shell completions.'
        'doc:Show plugin and configuration documentation.'
        'dumpjson:Dump the configuration in JSON format (after includes are processed).'
        'edit:Open the configuration file in $EDITOR, then reload.'
        'exit:Terminate the pyprland daemon.'
        'expose:Expose every client on the active workspace.'
        'fetch_client_menu:Select a client window and move it to the active workspace.'
        'gamemode:Toggle game mode (disables animations, blur, shadows, gaps, rounding).'
        'get:Get a configuration value.'
        'help:Show available commands or detailed help.'
        'hide:hides scratchpad "name" (accepts "*").'
        'layout_center:turn on/off or change the active window.'
        'reload:Reload the configuration file.'
        'set:Set a configuration value.'
        'show:shows scratchpad "name" (accepts "*").'
        'toggle:toggles visibility of scratchpad "name" (supports multiple names).'
        'toggle_special:Toggles switching the focused window to the special workspace "name" (default: minimized).'
        'unfetch_client:Return a window back to its origin.'
        'validate:Validate the configuration file.'
        'version:Show the pyprland version.'
        'zoom:zooms to "factor" or toggles zoom level if factor is omitted.'
    )

    _arguments -C \
        '1:command:->command' \
        '*::arg:->args'

    case $state in
        command)
            _describe 'command' commands
            ;;
        args)
            case $words[1] in
                bar)
                    _arguments \
                        '1:restart|stop|toggle:(restart stop toggle)'
                    ;;
                compgen)
                    _arguments \
                        '1:shell:(bash zsh fish)' \
                        '2:path:(default)'
                    ;;
                doc)
                    _arguments \
                        '1:plugin:(expose fetch_client_menu gamemode layout_center magnify menubar scratchpads system_notifier toggle_special)'
                    ;;
                get)
                    _arguments \
                        '1:plugin.key:'
                    ;;
                help)
                    if [[ $CURRENT -eq 2 ]]; then
                        # Position 1: complete with all commands
                        _describe 'command' commands
                    else
                        # Position 2+: complete subcommands based on previous word
                        case $words[2] in
                            *) ;;
                        esac
                    fi
                    ;;
                hide)
                    _arguments \
                        '1:name:(email file_manager system_monitor calendar sms browser unit_monitor term)'
                    ;;
                layout_center)
                    _arguments \
                        '1:toggle|next|prev|next2|prev2:(toggle next prev next2 prev2)'
                    ;;
                set)
                    _arguments \
                        '1:plugin.key:' \
                        '2:value:'
                    ;;
                show)
                    _arguments \
                        '1:name:(email file_manager system_monitor calendar sms browser unit_monitor term)'
                    ;;
                toggle)
                    _arguments \
                        '1:name:(email file_manager system_monitor calendar sms browser unit_monitor term)'
                    ;;
                toggle_special)
                    _arguments \
                        '1:name:'
                    ;;
                zoom)
                    _arguments \
                        '1:number (zoom level):'
                    ;;
            esac
            ;;
    esac
}

_pypr "$@"
